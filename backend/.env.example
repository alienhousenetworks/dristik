# ==============================================================================
# Dristik AI Backend Configuration Template (.env.example)
# Copy this file to .env and configure your preferred LLM provider key.
# ==============================================================================

# App & Server Settings
APP_NAME=Dristik AI
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# ==============================================================================
# Multi-Provider LLM Gateway Selection
# Choose one of: openrouter | groq | gemini | together | auto
# "auto" selects the first configured API key below.
# ==============================================================================
LLM_PROVIDER=openrouter

# ==============================================================================
# Custom Model Override Configuration
# Set LLM_MODEL to force a specific model for all tasks (Fast & Reasoning)
# Common OpenRouter Models: openai/gpt-4o, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct, google/gemini-2.0-flash-exp:free
# Common Groq Models: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.6-27b
# Common Gemini Models: gemini-2.0-flash, gemini-1.5-flash
# ==============================================================================
LLM_MODEL=openai/gpt-4o

# Optional granular model separation (overrides LLM_MODEL if set):
# LLM_MODEL_FAST=openai/gpt-4o
# LLM_MODEL_REASONING=openai/gpt-4o

# Option 1: Anthropic (Claude 3.5 Sonnet / 3.7 Sonnet / 3 Haiku)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Option 2: OpenRouter (Aggregator for GPT-4o, Claude, DeepSeek, Gemini, Llama)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://dristik.ai
OPENROUTER_SITE_NAME=Dristik AI

# Option 3: Google Gemini API (Recommended for Free Tier & Massive Scale)
# Get your free key at: https://aistudio.google.com/app/apikey
# Free limits: 15 RPM, 1,500 requests/day, 1M+ token context window.
GEMINI_API_KEY=

# Option 4: Groq (Recommended for Ultra-Fast LPU Inference)
# Get your free key at: https://console.groq.com/keys
# Free limits: Generous daily token limits, 500+ tokens/sec.
GROQ_API_KEY=

# Option 5: Together AI (Llama 3.3 70B / 3.1 8B Turbo)
# Get your key at: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Inference parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Actual USD you pay per 1 million tokens. Set both. They price every call
# whose provider did not return a bill (OpenRouter usage.cost still wins).
# Leave unset to use the published list price of the model that ran.
# LLM_COST_INPUT_PER_MILLION=1.00
# LLM_COST_OUTPUT_PER_MILLION=5.00
# Per-model rates. The first path segment must be the provider name.
# LLM_MODEL_PRICES={"groq/openai/gpt-oss-20b":{"input":0.075,"output":0.30},"anthropic/claude-haiku-4-5-20251001":{"input":1,"output":5}}

# ==============================================================================
# AI Citation Tracker Engine Configuration (Per-Engine Independent Controls)
# ==============================================================================
# Citation engines follow LLM_PROVIDER. Set AI_CITATION_CROSS_PROVIDER=true
# only if you want to query other vendors in addition to the audit provider.
AI_CITATION_CROSS_PROVIDER=false
# Active flags: Set true to evaluate, false to skip without failing the score.

# 1. Claude (Anthropic)
AI_CITATION_CLAUDE_ACTIVE=true
AI_CITATION_CLAUDE_PROVIDER=anthropic
AI_CITATION_CLAUDE_API_KEY=
AI_CITATION_CLAUDE_MODEL=claude-3-haiku-20240307

# 2. Google Gemini
AI_CITATION_GEMINI_ACTIVE=true
AI_CITATION_GEMINI_PROVIDER=gemini
AI_CITATION_GEMINI_API_KEY=
AI_CITATION_GEMINI_MODEL=gemini-2.0-flash

# 3. ChatGPT (OpenAI)
AI_CITATION_CHATGPT_ACTIVE=false
AI_CITATION_CHATGPT_PROVIDER=openai
AI_CITATION_CHATGPT_API_KEY=
AI_CITATION_CHATGPT_MODEL=gpt-4o-mini

# 4. Perplexity Pro (Sonar)
AI_CITATION_PERPLEXITY_ACTIVE=false
AI_CITATION_PERPLEXITY_PROVIDER=perplexity
AI_CITATION_PERPLEXITY_API_KEY=
AI_CITATION_PERPLEXITY_MODEL=sonar

# 5. DeepSeek
AI_CITATION_DEEPSEEK_ACTIVE=false
AI_CITATION_DEEPSEEK_PROVIDER=deepseek
AI_CITATION_DEEPSEEK_API_KEY=
AI_CITATION_DEEPSEEK_MODEL=deepseek-chat

# 6. Meta Llama 3.3 (only used when LLM_PROVIDER=groq, or CROSS_PROVIDER=true)
AI_CITATION_LLAMA_ACTIVE=false
AI_CITATION_LLAMA_PROVIDER=groq
AI_CITATION_LLAMA_API_KEY=
AI_CITATION_LLAMA_MODEL=openai/gpt-oss-120b

# 7. xAI Grok
AI_CITATION_GROK_ACTIVE=false
AI_CITATION_GROK_PROVIDER=xai
AI_CITATION_GROK_API_KEY=
AI_CITATION_GROK_MODEL=grok-2-latest

# 8. Kimi (Moonshot AI)
AI_CITATION_KIMI_ACTIVE=false
AI_CITATION_KIMI_PROVIDER=moonshot
AI_CITATION_KIMI_API_KEY=
AI_CITATION_KIMI_MODEL=moonshot-v1-8k

# ==============================================================================
# Vector Embeddings Configuration (E5-Small: ~130 MB, 384-dim, Fast CPU/Apple Silicon)
# Choose: huggingface (local on-device) | openrouter (cloud API)
# ==============================================================================
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/e5-small-v2
EMBEDDING_DEVICE=cpu
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Hugging Face Access Token (for authenticated Hub access & higher rate limits)
HF_TOKEN=

# Multi-Page Crawler & Web Ingestion Engine
FIRECRAWL_API_KEY=
JS_RENDER_THIN_PAGES=true
FIRECRAWL_WAIT_MS=3000
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_TIMEOUT_MS=15000
PLAYWRIGHT_HEADLESS=true
# Page crawl depth options: 5 | 10 | 20 | 50 | all (all = deep crawl full website)
MAX_CRAWL_PAGES=5
CRAWL_TIMEOUT_SECONDS=15
CRAWL_CONCURRENCY=3
USER_AGENT=Mozilla/5.0 (compatible; DristikBot/2.0; +https://dristik.ai/bot)
SSRF_PROTECTION_ENABLED=true

# Analysis Budget & Execution Guardrails
ANALYSIS_MAX_COST_USD=0.05
ANALYSIS_MAX_MODEL_CALLS=25
ANALYSIS_MAX_REASONING_CALLS=6
ANALYSIS_TIMEOUT_SECONDS=180

# ==============================================================================
# Auth & Dristik system admin
# Sign in with SYSTEM_ADMIN_EMAIL / SYSTEM_ADMIN_PASSWORD.
# Restart the backend after changing these — the system admin is updated on boot.
# Password must be 8+ characters with upper, lower, and a number.
# ==============================================================================
AUTH_SECRET=dristik-dev-secret-change-me
AUTH_DATABASE_PATH=data/dristik.db
SESSION_DAYS=14
FRONTEND_URL=http://localhost:5173
SYSTEM_ADMIN_EMAIL=admin@dristik.ai
SYSTEM_ADMIN_PASSWORD=DristikAdmin1!
SYSTEM_ADMIN_NAME=Dristik Admin

# Razorpay Payment Gateway Integration
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_CURRENCY=INR

# ==============================================================================
# 1-Click OAuth Single Sign-On (SSO) for User Authentication & Connectors
# ==============================================================================
# Dristik supports instant 1-click SSO login/signup and 1-click connector auth.
# Provide the keys below. Absent keys stay disabled (fail-closed, zero fake data).

# ------------------------------------------------------------------------------
# Google OAuth (User SSO + Search Console + GA4)
# ------------------------------------------------------------------------------
# In Google Cloud Console (https://console.cloud.google.com/apis/credentials):
#   - Application Type: Web application
#   - Authorized JavaScript origins:
#       http://localhost:5173
#       http://localhost:8000
#   - Authorized redirect URIs:
#       http://localhost:8000/api/v1/auth/oauth/google/callback        (User SSO)
#       http://localhost:8000/api/v1/connectors/google/oauth/callback (Google Search Console)
#       http://localhost:8000/api/v1/connectors/oauth/callback        (Google Analytics 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/oauth/callback
# Optional dedicated SSO override (falls back to GOOGLE_CLIENT_ID if unset):
# GOOGLE_SSO_CLIENT_ID=
# GOOGLE_SSO_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# GitHub OAuth (User SSO + Repository Pull Request Remediation Connector)
# ------------------------------------------------------------------------------
# In GitHub Developer Settings (https://github.com/settings/developers):
#   - Authorization callback URL for User SSO:
#       http://localhost:8000/api/v1/auth/oauth/github/callback
#   - Authorization callback URL for Connector:
#       http://localhost:8000/api/v1/connectors/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional dedicated SSO override (falls back to GITHUB_CLIENT_ID if unset):
# GITHUB_SSO_CLIENT_ID=
# GITHUB_SSO_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Connector Hub Universal OAuth Callback
# ------------------------------------------------------------------------------
# Register this exact redirect URI on Shopify, Webflow, HubSpot, Salesforce, Stripe, WordPress:
#   http://localhost:8000/api/v1/connectors/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connectors/oauth/callback

# CMS & Code Connectors
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

# CRM & Revenue Attribution Connectors
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=

