# ==============================================================================
# Dristik AI — Production Environment Configuration (.env)
# ==============================================================================

# Core System Environment
ENVIRONMENT=production
DEBUG=false
PRODUCTION_DATA_INTEGRITY_MODE=true
APP_NAME=Dristik AI
APP_VERSION=2.0.0

# Exposed Host Ports (change if needed)
FRONTEND_PORT=5173
BACKEND_PORT=8000

# ==============================================================================
# Security & Authentication (Auto-generated during ./setup.sh)
# ==============================================================================
# AUTH_SECRET must be at least 32 characters long
AUTH_SECRET=
SYSTEM_ADMIN_EMAIL=admin@dristik.ai
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_NAME=Dristik Admin
SESSION_DAYS=14

# ==============================================================================
# LLM Provider Configuration
# Choose one of: auto | openrouter | anthropic | groq | gemini | together | nvidia
# "auto" will automatically use whichever API key is filled below.
# ==============================================================================
LLM_PROVIDER=auto

# Option 1: Anthropic (Claude 3.5 Sonnet / 3.7 Sonnet / Haiku)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Option 2: OpenRouter (Universal gateway for GPT-4o, Claude, DeepSeek, Llama)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Option 3: Groq (Ultra-fast inference)
# https://console.groq.com/keys
GROQ_API_KEY=

# Option 4: Google Gemini
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 5: Together AI
TOGETHER_API_KEY=

# Option 6: NVIDIA NIM (Nemotron 120B / API Catalog)
# https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ==============================================================================
# Vector Embeddings (Runs 100% locally on your server CPU)
# ==============================================================================
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/e5-small-v2
EMBEDDING_DEVICE=cpu
# Optional Hugging Face Token (increases download rate limit from Hub)
HF_TOKEN=

# ==============================================================================
# Web Crawling & Headless Browser Engine
# ==============================================================================
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000
MAX_CRAWL_PAGES=5
CRAWL_TIMEOUT_SECONDS=15
CRAWL_CONCURRENCY=3
# Optional Firecrawl API Key (for external JS rendering fallback)
FIRECRAWL_API_KEY=

# ==============================================================================
# SEO Data & Connectors (Optional)
# ==============================================================================
# DataForSEO API (for SERP & backlink intelligence)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Chrome UX Report API Key
CRUX_API_KEY=

# Google OAuth (Search Console & GA4 Connector)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
